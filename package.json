{
  "name": "drupal-security-campaign-concepts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve --port=8080",
