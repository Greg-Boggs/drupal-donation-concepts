    "preview": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "axe-core": "4.14.1",
    "wrangler": "^4.168.0"
  },
  "dependencies": {
    "temporal-polyfill": "1.0.8"
  }
}
